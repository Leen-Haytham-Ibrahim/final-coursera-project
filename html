<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ course.name }}</title>
    {% load static %}
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="{% url 'onlinecourse:index' %}">Home</a>
        {% if user.is_authenticated %}
            <span class="navbar-text">{{ user.first_name }} ({{ user.username }})</span>
        {% endif %}
    </div>
</nav>

<div class="container-fluid">
    <h2>{{ course.name }}</h2>

    {% if grade %}
        {% if grade > 80 %}
            <div class="alert alert-success">
                <b>Congratulations, {{ user.first_name }}!</b> You have passed the exam and completed the course with a score of {{ grade }}/100.
            </div>
        {% else %}
            <div class="alert alert-danger">
                <b>Failed.</b> Sorry, {{ user.first_name }}! You have failed the exam with a score of {{ grade }}/100.
            </div>
            <a class="btn btn-link text-danger" href="{% url 'onlinecourse:course_details' course.id %}">Re-test</a>
        {% endif %}
    {% endif %}

    <form id="questionform" action="{% url 'onlinecourse:submit' course.id %}" method="post">
        {% csrf_token %}
        {% for lesson in course.lesson_set.all %}
            <div class="card mt-3">
                <div class="card-header"><h5>{{ lesson.order }}. {{ lesson.title }}</h5></div>
                <div class="card-body">
                    <p>{{ lesson.content }}</p>

                    {% for question in lesson.question_set.all %}
                        <div class="card mt-2">
                            <div class="card-header">
                                <b>{{ question.question_text }}</b>
                                {% if grade %}
                                    {% if question.id in selected_ids and question.is_get_score %}
                                    {% endif %}
                                {% endif %}
                            </div>
                            <div class="card-body">
                                {% for choice in question.choice_set.all %}
                                    <div class="form-check">
                                        {% if grade %}
                                            {% if choice.is_correct and choice.id in selected_ids %}
                                                <div class="text-success">Correct answer: {{ choice.choice_text }}</div>
                                            {% elif choice.is_correct and choice.id not in selected_ids %}
                                                <div class="text-warning">Not selected: {{ choice.choice_text }}</div>
                                            {% elif not choice.is_correct and choice.id in selected_ids %}
                                                <div class="text-danger">Wrong answer: {{ choice.choice_text }}</div>
                                            {% else %}
                                                <div>{{ choice.choice_text }}</div>
                                            {% endif %}
                                        {% else %}
                                            <input type="checkbox" class="form-check-input"
                                                   name="choice_{{ choice.id }}"
                                                   id="choice_{{ choice.id }}"
                                                   value="{{ choice.id }}">
                                            <label class="form-check-label" for="choice_{{ choice.id }}">
                                                {{ choice.choice_text }}
                                            </label>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        {% if not grade %}
            <input class="btn btn-primary mt-3 mb-5" type="submit" value="Submit">
        {% endif %}
    </form>
</div>
</body>
</html>
